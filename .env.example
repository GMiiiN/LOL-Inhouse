# .env 견본. 실제 값은 .env에 넣는다(.env는 git 제외).
# 각 값이 어디서 쓰이는지 적어 둔다. 자세한 설명: docs/study/01-repository-skeleton.md

# AI 추출에 쓰는 Gemini API 키. backend(ingest)와 tools/extraction-lab이 읽는다.
GEMINI_API_KEY=
# 사용할 Gemini 모델 이름. 실험(M0) 결과에 따라 바꿀 수 있게 설정으로 뺐다.
GEMINI_MODEL=gemini-3.8-flash

# infra/docker-compose.yml의 MySQL 컨테이너가 처음 뜰 때 이 값으로 DB와 계정을 만든다.
MYSQL_DATABASE=lol_inhouse
MYSQL_USER=lol_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# compose MySQL을 PC의 몇 번 포트로 열지. PC에 설치된 MySQL(3306)과 겹치지 않게 3307.
MYSQL_HOST_PORT=3307
# backend가 접속할 JDBC 주소. 포트는 MYSQL_HOST_PORT와 같아야 한다.
DB_URL=jdbc:mysql://localhost:3307/lol_inhouse

# 담당자 계정. backend가 첫 실행 때 계정이 없으면 이 값으로 만든다(비밀번호는 BCrypt로 해시 저장).
ADMIN_USERNAME=
ADMIN_PASSWORD=
