# .env 견본. 실제 값은 .env에 넣는다(.env는 git 제외).
# 각 값이 어디서 쓰이는지 적어 둔다.

# AI 추출에 쓰는 Gemini API 키. backend(ingest)와 tools/extraction-lab이 읽는다.
GEMINI_API_KEY=
# 사용할 Gemini 모델 이름. 실험(M0) 결과에 따라 바꿀 수 있게 설정으로 뺐다.
GEMINI_MODEL=gemini-3.8-flash

# infra/docker-compose.yml의 MySQL 컨테이너가 처음 뜰 때 이 값으로 DB와 계정을 만든다.
MYSQL_DATABASE=lol_inhouse
MYSQL_USER=lol_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# compose MySQL을 PC의 몇 번 포트로 열지. PC에 설치된 MySQL(3306)과 겹치지 않게 3307.
MYSQL_HOST_PORT=3307
# backend가 접속할 JDBC 주소. 포트는 MYSQL_HOST_PORT와 같아야 한다.
DB_URL=jdbc:mysql://localhost:3307/lol_inhouse

# 담당자 계정. backend가 첫 실행 때 계정이 없으면 이 값으로 만든다(비밀번호는 BCrypt로 해시 저장).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 세션 쿠키(JSESSIONID, XSRF-TOKEN)에 Secure 속성을 붙일지. 로컬 개발(http)은 false, 데스크탑 운영(터널의 HTTPS로 접속)은 true.
# true인데 http://localhost:8088로 접속하면 로그인이 안 된다(브라우저가 쿠키를 버린다). 설명: docs/ops/desktop-setup.md
COOKIE_SECURE=false

# (선택) 업로드한 결과창 이미지를 저장할 폴더. 설정하지 않으면 ../data/images(저장소 루트의 data/, git 제외). M7에서 S3로 교체.
# 친구 닉네임이 들어 있는 이미지라 공개 저장소에 올리면 안 된다.
# 줄만 두고 값을 비우면 빈 문자열이 기본값을 덮어쓰므로, 바꿀 때만 주석을 풀고 값을 넣는다.
# IMAGE_STORE_DIR=../data/images
# (선택) Data Dragon(챔피언 아이콘·목록) 디스크 캐시 폴더. 설정하지 않으면 ../data/ddragon.
# DDRAGON_CACHE_DIR=../data/ddragon

# (선택, 데스크탑 운영) infra/compose.desktop.yml의 웹 입구를 PC의 몇 번 포트로 열지(127.0.0.1에만 열림). 기본 8088.
# 줄만 두고 값을 비우면 빈 문자열이 기본값을 덮어쓰므로, 바꿀 때만 주석을 풀고 값을 넣는다.
# WEB_PORT=8088
# 데스크탑 운영에서는 DB_URL·IMAGE_STORE_DIR·DDRAGON_CACHE_DIR이 compose에서 컨테이너 안 값으로 덮어써진다(.env에 있어도 무시).
